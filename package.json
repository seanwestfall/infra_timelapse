{
  "name": "infra-timelapse-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bash deploy/build_web.sh",
    "deploy": "bash deploy/deploy_cloudflare.sh",
    "deploy:worker": "bash deploy/deploy_cloudflare.sh --worker production --pages never",
    "secret:database": "wrangler secret put DATABASE_URL --config web/worker/wrangler.jsonc",
    "deploy:pages": "bash deploy/deploy_cloudflare.sh --worker never --pages always",
    "test": "node --test web/worker/test/*.test.mjs",
    "test:worker": "node --test web/worker/test/*.test.mjs",
    "validate:manifest": "python3 deploy/cloudflare_manifest.py validate",
    "validate:worker": "npm run validate:manifest && wrangler deploy --config web/worker/wrangler.jsonc --dry-run",
    "check:production": "bash deploy/check_production.sh"
  },
  "devDependencies": {
    "wrangler": "4.120.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0"
  }
}
